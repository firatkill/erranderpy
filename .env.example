# Copy this file to .env (./start.sh does it for you) and fill in the values.

# --- Telegram -------------------------------------------------------------
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=

# --- LLM: fill in AT LEAST ONE key ----------------------------------------
# If several are filled, the first one in this order is used:
#   Anthropic -> Gemini -> DeepSeek -> OpenAI
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (anthropic | gemini | deepseek | openai)
LLM_PROVIDER=
# Optional: override the provider's default model
LLM_MODEL=

# --- General --------------------------------------------------------------
TIMEZONE=Europe/Istanbul
# Language of the bot's fixed replies: tr | en (it answers free text in your language anyway)
BOT_LANGUAGE=tr
# Evening summary of tasks and habits (HH:MM), or 'off'
SUMMARY_TIME=21:00
# Optional: where the SQLite database lives (default: data/assistant.db)
DB_PATH=
